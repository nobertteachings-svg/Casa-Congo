{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.casahomesdrcongo.com",
        "EXPO_PUBLIC_API_URL_FALLBACK": "https://casa-backend-production-add3.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.casahomesdrcongo.com",
        "EXPO_PUBLIC_API_URL_FALLBACK": "https://casa-backend-production-add3.up.railway.app"
      }
    },
    "production-android": {
      "extends": "production",
      "credentialsSource": "local"
    },
    "android-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "mutaleyinguhalain@gmail.com",
        "ascAppId": "6816472088",
        "appleTeamId": "X59YSW73S8"
      }
    }
  }
}
