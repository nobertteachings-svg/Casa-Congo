{
  "expo": {
    "name": "Casa Congo",
    "slug": "casa-congo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "casacd",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.casahomesrdc.app",
      "icon": "./assets/ios-icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Casa utilise votre position pour trouver des logements près de vous.",
        "NSCameraUsageDescription": "Casa utilise l'appareil photo pour les photos d'annonce et la vérification d'identité.",
        "NSMicrophoneUsageDescription": "Casa utilise le micro pour enregistrer les vidéos de visite.",
        "NSPhotoLibraryUsageDescription": "Casa vous permet de choisir des photos d'annonce dans votre galerie.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "config": {}
    },
    "android": {
      "package": "com.casahomesrdc.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.casahomesdrcongo.com",
              "pathPrefix": "/listing"
            },
            {
              "scheme": "https",
              "host": "casahomesdrcongo.com",
              "pathPrefix": "/listing"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f2f24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDZQw4v0PPjeer5WZn7li6l634bDLGRr4Q"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f2f24"
        }
      ],
      "expo-secure-store",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1B8E3E",
          "defaultChannel": "casa-alerts",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDZQw4v0PPjeer5WZn7li6l634bDLGRr4Q"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Casa utilise l'appareil photo pour les photos d'annonce et la vérification d'identité.",
          "photosPermission": "Casa vous permet de choisir des photos d'annonce dans votre galerie."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-video"
    ],
    "owner": "nobertteachingss-team",
    "extra": {
      "eas": {
        "projectId": "2eed9944-db0e-4549-bd2c-9ad684794782"
      }
    }
  }
}
